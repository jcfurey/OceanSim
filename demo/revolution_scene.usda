#usda 1.0
(
    defaultPrim = "RevolutionInspectionSite"
    metersPerUnit = 1
    upAxis = "Z"
)

# Dependency-free subsea inspection site for the Deep Trekker REVOLUTION.
# The optional OceanSim asset pack provides the photogrammetry-based MHL scene;
# this procedural environment keeps the default launch visually and
# acoustically useful without external downloads.
def Xform "RevolutionInspectionSite"
{
    def DomeLight "UnderwaterAmbient"
    {
        color3f color = (0.18, 0.38, 0.48)
        float intensity = 520
    }

    def RectLight "WorkLight"
    {
        color3f color = (0.48, 0.72, 0.78)
        float intensity = 2400
        float width = 5
        float height = 3
        double3 xformOp:rotateXYZ = (0, 35, 180)
        double3 xformOp:translate = (-1.5, 0, 1.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # Broad sandy seafloor and distant rock shelves bound the operating area.
    def Cube "Seafloor" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.24, 0.29, 0.25)]
        double size = 1
        double3 xformOp:scale = (10, 7, 0.12)
        double3 xformOp:translate = (1, 0, -2.62)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "AftShelf" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.12, 0.20, 0.18)]
        double size = 1
        double3 xformOp:scale = (1.0, 6.5, 1.0)
        double3 xformOp:translate = (-8.5, 0, -1.75)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "ForwardShelf" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.12, 0.20, 0.18)]
        double size = 1
        double3 xformOp:scale = (1.0, 6.5, 1.0)
        double3 xformOp:translate = (10.5, 0, -1.75)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    # A corroded subsea pipeline runs through the inspection corridor.
    def Xform "Pipeline"
    {
        def Cylinder "MainPipe" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "X"
            color3f[] primvars:displayColor = [(0.31, 0.34, 0.30)]
            double height = 8.5
            double radius = 0.18
            double3 xformOp:translate = (2.2, 1.25, -2.08)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "FlangeA" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "X"
            color3f[] primvars:displayColor = [(0.48, 0.28, 0.12)]
            double height = 0.14
            double radius = 0.29
            double3 xformOp:translate = (0.2, 1.25, -2.08)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "FlangeB" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "X"
            color3f[] primvars:displayColor = [(0.48, 0.28, 0.12)]
            double height = 0.14
            double radius = 0.29
            double3 xformOp:translate = (3.4, 1.25, -2.08)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cube "SupportA" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.20, 0.23, 0.21)]
            double size = 1
            double3 xformOp:scale = (0.45, 0.45, 0.32)
            double3 xformOp:translate = (-0.8, 1.25, -2.34)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "SupportB" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.20, 0.23, 0.21)]
            double size = 1
            double3 xformOp:scale = (0.45, 0.45, 0.32)
            double3 xformOp:translate = (4.6, 1.25, -2.34)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cylinder "Riser" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            color3f[] primvars:displayColor = [(0.28, 0.31, 0.27)]
            double height = 1.65
            double radius = 0.16
            double3 xformOp:translate = (5.3, 1.25, -1.35)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "ValveWheel" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Y"
            color3f[] primvars:displayColor = [(0.85, 0.38, 0.06)]
            double height = 0.08
            double radius = 0.32
            double3 xformOp:translate = (5.3, 1.05, -0.7)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    # Steel inspection frame directly ahead of the default spawn position.
    def Xform "InspectionFrame"
    {
        def Cube "LeftPost" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.78, 0.45, 0.08)]
            double size = 1
            double3 xformOp:scale = (0.09, 0.09, 1.0)
            double3 xformOp:translate = (2.1, -1.25, -1.55)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "RightPost" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.78, 0.45, 0.08)]
            double size = 1
            double3 xformOp:scale = (0.09, 0.09, 1.0)
            double3 xformOp:translate = (2.1, 1.25, -1.55)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "TopBeam" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.78, 0.45, 0.08)]
            double size = 1
            double3 xformOp:scale = (0.09, 1.34, 0.09)
            double3 xformOp:translate = (2.1, 0, -0.58)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "InspectionPanel" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.08, 0.32, 0.46)]
            double size = 1
            double3 xformOp:scale = (0.08, 0.62, 0.48)
            double3 xformOp:translate = (2.08, 0, -1.18)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "TargetStripeA"
        {
            color3f[] primvars:displayColor = [(0.92, 0.84, 0.12)]
            double size = 1
            double3 xformOp:scale = (0.045, 0.50, 0.035)
            double3 xformOp:translate = (2.025, 0, -1.02)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "TargetStripeB"
        {
            color3f[] primvars:displayColor = [(0.92, 0.84, 0.12)]
            double size = 1
            double3 xformOp:scale = (0.045, 0.50, 0.035)
            double3 xformOp:translate = (2.025, 0, -1.34)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    # Pier pilings and cross-braces create useful camera/sonar occlusion.
    def Xform "Pier"
    {
        def Cylinder "PilingPort" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.19, 0.25, 0.24)]
            double height = 4.4
            double radius = 0.28
            double3 xformOp:translate = (6.5, -2.7, -0.4)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "PilingStarboard" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.19, 0.25, 0.24)]
            double height = 4.4
            double radius = 0.28
            double3 xformOp:translate = (6.5, 2.7, -0.4)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cube "CrossBeam" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.17, 0.22, 0.21)]
            double size = 1
            double3 xformOp:scale = (0.30, 3.15, 0.18)
            double3 xformOp:translate = (6.5, 0, 0.85)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    # Natural clutter keeps the scene from reading as an empty test chamber.
    def Sphere "BoulderA"
    {
        color3f[] primvars:displayColor = [(0.17, 0.23, 0.20)]
        double radius = 1
        double3 xformOp:scale = (0.75, 0.55, 0.38)
        double3 xformOp:translate = (-0.2, -2.7, -2.28)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Sphere "BoulderB"
    {
        color3f[] primvars:displayColor = [(0.20, 0.25, 0.21)]
        double radius = 1
        double3 xformOp:scale = (0.52, 0.72, 0.30)
        double3 xformOp:translate = (3.8, -3.1, -2.32)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Sphere "BoulderC"
    {
        color3f[] primvars:displayColor = [(0.15, 0.21, 0.19)]
        double radius = 1
        double3 xformOp:scale = (0.42, 0.38, 0.26)
        double3 xformOp:translate = (6.8, 3.9, -2.38)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "EquipmentCrate" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.50, 0.34, 0.10)]
        double size = 1
        double3 xformOp:rotateXYZ = (0, 0, 12)
        double3 xformOp:scale = (0.52, 0.38, 0.34)
        double3 xformOp:translate = (4.0, -1.8, -2.22)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }
}
